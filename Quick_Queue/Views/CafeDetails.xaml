<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Quick_Queue.Views.CafeDetails"
    Title="Café Details">

    <VerticalStackLayout Padding="20"
                         Spacing="20">

        <Image Source="{Binding CurrentCafe.ImageName}"
               HeightRequest="200"
               Aspect="AspectFill"
               HorizontalOptions="Center" />

        <Label Text="{Binding CurrentCafe.Name}"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!--
            JESS'S SECTION NO TOUCH!
            Queue time calculations
            & any additional UI code you wanna add
        -->

        <Label Text="Current Queue"
               FontSize="24"
               FontAttributes="Bold" />

        <Label Text="Number of people waiting:" />

        <Entry x:Name="PeopleWaitingEntry"
               Placeholder="Enter number of people"
               Keyboard="Numeric" />

        <Button Text="Calculate Wait"
                Clicked="OnCalculateWaitClicked" />

        <VerticalStackLayout x:Name="QueueResultLayout"
                             IsVisible="False"
                             Spacing="8">

            <Label x:Name="PeopleWaitingLabel"
                   FontSize="18" />

            <Label x:Name="EstimatedWaitLabel"
                   FontSize="18" />

            <Label x:Name="QueueStatusLabel"
                   FontSize="20"
                   FontAttributes="Bold" />

            <Label x:Name="RecommendationLabel"
                   FontSize="18" />

        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>