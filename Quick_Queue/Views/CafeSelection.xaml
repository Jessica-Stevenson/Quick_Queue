<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Quick_Queue.Views.CafeSelection"
    Title="Choose a Café">

    <VerticalStackLayout Padding="20"
                         Spacing="20">

        <Label Text="Choose a Café"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Picker Title="Select a location"
                ItemsSource="{Binding Cafes}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedCafe}" />

        <Border Stroke="#e0e0e0"
                BackgroundColor="#e0e0e0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="15"
                HorizontalOptions="Fill"
                VerticalOptions="Center">

            <Grid RowDefinitions="*,Auto,Auto">

                <Label Text="No Cafe Selected"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Grid.Row="0"
                       IsVisible="{Binding SelectedCafe, TargetNullValue=True}" />

                <Image Source="{Binding SelectedCafe.ImageName}"
                       HeightRequest="180"
                       Aspect="AspectFill"
                       HorizontalOptions="Center"
                       Grid.Row="0"
                       IsVisible="{Binding SelectedCafe}" />

                <Label Text="{Binding SelectedCafe.Name}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"
                       Grid.Row="1"
                       IsVisible="{Binding SelectedCafe}" />

                <Button Text="Continue"
                        BackgroundColor="#6C4CC2"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        WidthRequest="200"
                        HorizontalOptions="Center"
                        Margin="0,10,0,0"
                        Grid.Row="2"
                        Command="{Binding ContinueCommand}"
                        IsVisible="{Binding SelectedCafe}" />

            </Grid>

        </Border>

    </VerticalStackLayout>

</ContentPage>