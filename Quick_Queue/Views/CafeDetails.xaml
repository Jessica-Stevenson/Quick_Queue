<?xml version="1.0" encoding="utf-8" ?>
<Window xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="Quick_Queue.Views.CafeDetails">

    <ContentPage>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Image Source="{Binding CurrentCafe.ImagePath}"
                   HeightRequest="200"
                   Aspect="AspectFill"
                   HorizontalOptions="Center" />

            <Label Text="{Binding CurrentCafe.Name}"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- 
                JESS'S SECTION NO TOUCH!
                Queue time calculations
                & any additional UI code you wanna add
            -->

        </VerticalStackLayout>
    </ContentPage>

</Window>
